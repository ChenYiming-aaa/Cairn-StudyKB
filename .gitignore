# ── Python ─────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Node / 前端 ────────────────────────
node_modules/
package-lock.json.bak
.vite/

# ── 项目数据（绝不入库）────────────────
# data.db 里有你的全部知识库内容，绝不能提交
data/
*.db
*.db-wal
*.db-shm
models/
logs/
tmp/

# ── 密钥 ───────────────────────────────
.env
.env.local
.env.*.local
# 登录助手导出的 cookie 就是登录态，等同密码；data/ 已被忽略，这里兜住指到别处的配置
cookies.txt

# ── 构建产物 ───────────────────────────
dist/
# github.io 静态演示包（CI 里现构建，不入库）
dist-demo/
release/
release-verify/
# 组件 zip（tools/build_components.py 产出，几 GB 级；发布时才上传到 GitHub Release）
release-components/
# 量体积时的试打目录（release-m8 / release-m8b / …），别入库
release-m8*/
build/
*.spec
# 例外：打包配置是源码的一部分，要能复现构建（T5.6）
!backend/cairn-backend.spec
!docs/**/*.spec
# 例外：应用图标是 `python tools/make_icon.py` 的产物，同样要能复现构建
!desktop/build/
!desktop/build/icon.ico
!desktop/build/icon.png
# ffmpeg 二进制由 tools/prepare_ffmpeg.py 从本机复制，不入库（约 74MB）
desktop/resources/ffmpeg/

# ── e2e / 空壳验证运行现场 ─────────────
frontend/e2e/_shots/
desktop/_smoke/

# ── 编辑器 / 系统 ──────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 工具运行时数据（私有工作笔记，不入库）──
.workbuddy/
