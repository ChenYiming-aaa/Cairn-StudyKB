# ─────────────────────────────────────────────
# 环境变量模板
# 用法：复制本文件为 .env，填入真实值。.env 已被 gitignore，不会提交。
# ─────────────────────────────────────────────

# ── LLM（必填）──────────────────────────────
# 任意 OpenAI 兼容服务都可以。DeepSeek 填下面这三行即可。
# 注意 base_url 末尾要带 /v1，代码会拼成 {base}/chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── 可选：其他兼容服务参考 ───────────────────
# 硅基流动   LLM_BASE_URL=https://api.siliconflow.cn/v1    LLM_MODEL=deepseek-ai/DeepSeek-V3
# 阿里百炼   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1    LLM_MODEL=qwen-plus
# 本地 Ollama LLM_BASE_URL=http://127.0.0.1:11434/v1       LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama

# ── ffmpeg（M2 用；留空则从 PATH 查找）───────
# 本机装在 Anaconda 下，从 IDE 启动时 PATH 可能没有它，所以这里显式指定
FFMPEG_DIR=D:\Anaconda3\Library\bin

# ── 模型下载源（强烈建议保留）────────────────
# 本机直连 huggingface.co 很慢/不通，走镜像下载 bge 与 whisper 模型
HF_ENDPOINT=https://hf-mirror.com

# ── 数据目录（可选）──────────────────────────
# 留空则：开发模式用 ./data，打包后自动用 %APPDATA%/Cairn
# DATA_DIR=./data
