{
  "name": "cairn-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Cairn 桌面壳：随机端口 + HTTP 握手拉起本地后端，窗口加载同源页面",
  "main": "main.js",
  "author": "Cairn",
  "scripts": {
    "start": "electron .",
    "ffmpeg": "python ../tools/prepare_ffmpeg.py",
    "pack": "npm run ffmpeg && electron-builder --dir --publish never",
    "dist": "npm run ffmpeg && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cairn.app",
    "productName": "Cairn",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "semver.js",
      "error.html",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/build/dist/cairn-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "web"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cairn-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Cairn"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ChenYiming-aaa",
        "repo": "Cairn-StudyKB",
        "releaseType": "release"
      }
    ]
  }
}
