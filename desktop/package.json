{
  "name": "cairn-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn 桌面壳：随机端口 + HTTP 握手拉起本地后端，窗口加载同源页面",
  "main": "main.js",
  "author": "Cairn",
  "scripts": {
    "start": "electron .",
    "ffmpeg": "python ../tools/prepare_ffmpeg.py",
    "pack": "npm run ffmpeg && electron-builder --dir --publish never",
    "dist": "npm run ffmpeg && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cairn.app",
    "productName": "Cairn",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "error.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/build/dist/cairn-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "web"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cairn-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.invalid/cairn"
      }
    ]
  }
}
